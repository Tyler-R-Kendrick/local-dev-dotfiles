+func TestE2E_StrictNoCowCleansUp(t *testing.T) {
+	if _, err := exec.LookPath("git"); err != nil {
+		t.Skip("git not on PATH")
+	}
+
+	gitCowWorktree := buildGitCowWorktree(t)
+	r := newRepo(t, "strict")
+	r.commit("a.txt", "alpha")
+	r.branch("target", "HEAD")
+	r.worktree("src", "target")
+
+	out := filepath.Join(r.parent, "out")
+	cmd := exec.Command(gitCowWorktree, "add", "--from", filepath.Join(r.parent, "src"), "--detach", out, "target")
+	cmd.Dir = r.dir
+	cmd.Env = append(os.Environ(),
+		"GIT_COW_WORKTREE_FORCE_NO_COW=1",
+		"GIT_COW_WORKTREE_STRICT_ROOT="+r.parent,
+	)
+	if got, err := cmd.CombinedOutput(); err == nil {
+		t.Fatalf("strict CoW unexpectedly succeeded:\n%s", got)
+	}
+	if _, err := os.Stat(out); !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("partial worktree remains: %v", err)
+	}
+	if got := gitOutput(t, r.dir, "worktree", "list", "--porcelain"); strings.Contains(got, out) {
+		t.Fatalf("stale worktree registration remains:\n%s", got)
+	}
+}
