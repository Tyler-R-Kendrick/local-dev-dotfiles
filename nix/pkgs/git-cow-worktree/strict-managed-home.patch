+func strictTarget(target string) bool {
+	root := strings.TrimSpace(os.Getenv("GIT_COW_WORKTREE_STRICT_ROOT"))
+	return root != "" && pathHasPrefix(target, root)
+}
+
+func removeWorktree(repoDir, target string) error {
+	cmd := exec.Command("git", "worktree", "remove", "--force", "--force", target)
+	cmd.Dir = repoDir
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("cleanup failed: %w (%s)", err, strings.TrimSpace(string(out)))
+	}
+	return nil
+}
