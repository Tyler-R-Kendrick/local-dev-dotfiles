#!/usr/bin/env bash
set -euo pipefail

usage() {
	echo "usage: repo-bootstrap URL [DEST] [-- SPARSE_PATH ...]" >&2
	exit 2
}

[[ $# -ge 1 ]] || usage
url=$1
shift

name=${url##*/}
name=${name%.git}
dest="$HOME/repos/$name"
if [[ $# -gt 0 && $1 != -- ]]; then
	dest=$1
	shift
fi

sparse=()
if [[ ${1:-} == -- ]]; then
	shift
	sparse=("$@")
elif [[ $# -gt 0 ]]; then
	usage
fi

if ((${#sparse[@]})); then
	git clone --filter=blob:none --no-checkout "$url" "$dest"
	git -C "$dest" sparse-checkout set --cone "${sparse[@]}"
	git -C "$dest" checkout
else
	git clone --filter=blob:none "$url" "$dest"
fi
