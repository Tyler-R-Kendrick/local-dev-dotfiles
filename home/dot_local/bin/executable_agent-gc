#!/usr/bin/env bash
set -euo pipefail

apply=false
case ${1:-} in
'') ;;
--apply) apply=true ;;
*)
	echo "usage: agent-gc [--apply]" >&2
	exit 2
	;;
esac

policy=${DEV_POLICY:-"$HOME/.config/dev/policy.yaml"}
state_root=${XDG_STATE_HOME:-"$HOME/.local/state"}/agent-workspaces
stale_days=$(yq -r '.workspace.staleDays // 7' "$policy" 2>/dev/null || echo 7)
now=$(date +%s)

active_path() {
	local path=$1 cwd link
	for link in /proc/[0-9]*/cwd; do
		cwd=$(readlink "$link" 2>/dev/null || true)
		[[ $cwd != "$path" && $cwd != "$path/"* ]] || return 0
	done
	return 1
}

locked_path() {
	local source=$1 path=$2
	git -C "$source" worktree list --porcelain | awk -v wanted="$path" '
    $1 == "worktree" { current = substr($0, 10) }
    $1 == "locked" && current == wanted { found = 1 }
    END { exit !found }
  '
}

reject() { printf 'keep\t%s\t%s\n' "$1" "$2"; }

shopt -s nullglob
records=("$state_root"/*.json)
if ((${#records[@]} == 0)); then
	echo "no managed workspaces"
	exit 0
fi

for record in "${records[@]}"; do
	path=$(jq -r .path "$record")
	source=$(jq -r .source "$record")
	created=$(jq -r .createdAt "$record")

	if [[ ! -e $path ]]; then
		printf 'stale-metadata\t%s\n' "$path"
		$apply && rm -- "$record"
		continue
	fi
	[[ -d $source ]] || {
		reject "$path" "source-missing"
		continue
	}
	(((now - created) / 86400 >= stale_days)) || {
		reject "$path" "younger-than-${stale_days}d"
		continue
	}
	[[ -z $(git -C "$path" status --porcelain) ]] || {
		reject "$path" dirty
		continue
	}
	! active_path "$path" || {
		reject "$path" active
		continue
	}
	! locked_path "$source" "$path" || {
		reject "$path" locked
		continue
	}

	branch=$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
	[[ -n $branch ]] || {
		reject "$path" detached
		continue
	}
	remote_head=$(git -C "$source" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
	if [[ -z $remote_head ]]; then
		for candidate in refs/remotes/origin/main refs/remotes/origin/master; do
			if git -C "$source" show-ref --verify --quiet "$candidate"; then
				remote_head=$candidate
				break
			fi
		done
	fi
	[[ -n $remote_head ]] || {
		reject "$path" no-remote-default
		continue
	}
	default_branch=${remote_head#refs/remotes/origin/}
	[[ $branch != "$default_branch" ]] || {
		reject "$path" default-branch
		continue
	}
	git -C "$source" merge-base --is-ancestor "refs/heads/$branch" "$remote_head" || {
		reject "$path" unmerged
		continue
	}

	if $apply; then
		git -C "$source" worktree remove "$path"
		rm -- "$record"
		printf 'removed\t%s\n' "$path"
	else
		printf 'eligible\t%s\n' "$path"
	fi
done
